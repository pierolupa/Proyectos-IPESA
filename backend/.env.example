# Copia este archivo a .env (no se commitea) para desarrollo local con
# `vercel dev`. En producción, estas mismas variables se configuran como
# "Environment Variables" en el dashboard del proyecto en Vercel.

# ID de la hoja de cálculo "IPESA - Guías" (está en la URL de la hoja:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit)
SHEET_ID=

# Contenido COMPLETO del archivo JSON de la cuenta de servicio de Google
# (todo en una sola línea). Se obtiene al crear la clave en IAM y
# administración → Cuentas de servicio → tu cuenta → Claves → Agregar
# clave → JSON. Nunca commitear este valor.
GOOGLE_SERVICE_ACCOUNT_KEY=
